# ==============================================================================
# ApexFinance environment configuration
# ==============================================================================
# Copy to .env (cp .env.example .env). The app loads .env from the project root, and
# docker compose reads it too. Real environment variables take precedence over the file.
# Never commit .env.

# --- Server -------------------------------------------------------------------
# Docker: docker-compose.yml already sets NODE_ENV, HOST, PORT and TRUST_PROXY.
# Running directly with Node: use NODE_ENV=development for local work.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public URL of the app, used in emailed links (invites). Required in production.
APP_URL=https://finance.yourdomain.com

# This file is loaded automatically from the project root as .env (copy it: cp .env.example .env).
# Real environment variables take precedence over values in .env.

# Security & Authentication
# REQUIRED when NODE_ENV=production (min 32 chars) — the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, a random secret is generated per process if unset (logins reset on restart).
JWT_SECRET=

# Storage
# DATABASE_PATH=./storage/apexfinance.sqlite
# Path to Chrome/Chromium used for PDF rendering (auto-detected if unset)
# CHROME_BIN=/usr/bin/chromium

# Set to true only when behind a reverse proxy you control (Caddy in docker compose).
# TRUST_PROXY=true

# Allow a separately hosted frontend to call the API. Leave unset for the bundled UI.
# CORS_ORIGIN=https://app.yourdomain.com

# --- Security -----------------------------------------------------------------
# REQUIRED in production (at least 32 characters); the server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=

# --- First administrator (production, empty database only) ---------------------
# On first start with an empty database, this account and company are created.
# Leave ADMIN_PASSWORD unset to have a random one printed once in the logs
# (docker compose logs app). Either way it must be changed at first login.
# These are ignored once any user exists, so you can remove them afterwards.
ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=
ADMIN_NAME=Your Name
ADMIN_COMPANY_NAME=Your Company Ltd
ADMIN_COMPANY_CURRENCY=GHS

# --- Demo mode ----------------------------------------------------------------
# Seeds sample companies and users with PUBLIC passwords and shows one-click demo
# logins. Default: on in development, off in production. Never enable it on a
# server holding real data.
# DEMO_MODE=false

# --- Storage ------------------------------------------------------------------
# Docker: /app/storage is a named volume (database, generated PDFs, backups).
# DATABASE_PATH=./storage/apexfinance.sqlite
# CHROME_BIN=/usr/bin/chromium       # auto-detected; set in the Docker image
# BACKUP_DIR=./storage/backups
# BACKUP_KEEP=14

# --- Email (SMTP) -------------------------------------------------------------
# Any SMTP provider works. Namecheap/cPanel mailbox example:
#   cPanel > Email Accounts > create notifications@yourdomain.com,
#   then "Connect Devices" shows the outgoing server (mail.yourdomain.com or premiumXX.web-hosting.com).
# Without SMTP settings, emails are only logged (development).
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=
SMTP_FROM="ApexFinance" <notifications@yourdomain.com>
