# ==============================================================================
# ApexFinance Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_URL=https://finance.yourdomain.com

# This file is loaded automatically from the project root as .env (copy it: cp .env.example .env).
# Real environment variables take precedence over values in .env.

# Security & Authentication
# REQUIRED when NODE_ENV=production (min 32 chars) — the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, a random secret is generated per process if unset (logins reset on restart).
JWT_SECRET=

# Storage
# DATABASE_PATH=./storage/apexfinance.sqlite
# Path to Chrome/Chromium used for PDF rendering (auto-detected if unset)
# CHROME_BIN=/usr/bin/chromium

# ==============================================================================
# Namecheap / cPanel SMTP Email Configuration (Free Webmail)
# ==============================================================================
# 1. In Namecheap cPanel, go to "Email Accounts" and create an account (e.g. notifications@yourdomain.com)
# 2. Under "Email Accounts", click "Connect Devices" to find your outgoing mail server name.
#    Typically: mail.yourdomain.com or premiumXX.web-hosting.com
# 3. Enter your credentials below:

SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=YourEmailPasswordHere
SMTP_FROM="ApexFinance" <notifications@yourdomain.com>
